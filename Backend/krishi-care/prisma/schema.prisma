// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./database.db" // Ensure this path is correct for your setup
}

// --- Normalized Models ---

// User Model: Contains common data for ALL users
model User {
  id                 Int      @id @default(autoincrement())
  username           String   @unique
  password           String   // Store hashed passwords!
  profilePictureUrl  String?  // Optional: URL for profile picture
  fullName           String
  phoneNumber        String   @unique
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  // Relationship to Role model (One User to One Role)
  roleId             Int
  role               Role     @relation(fields: [roleId], references: [id])

  // Optional One-to-One relationships to specific profile models
  // A user will have *one* of these depending on their role
  specialistProfile  SpecialistProfile?
  farmerProfile      FarmerProfile?
}

// Role Model: Defines the types of roles available
model Role {
  id        Int      @id @default(autoincrement())
  name      RoleType @unique // Role name (e.g., 'FARMER', 'SPECIALIST')
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // A role can be assigned to many users
  users     User[]
}

// Enum for predefined roles (ensures type safety for Role.name)
enum RoleType {
  FARMER
  SPECIALIST
}

// SpecialistProfile Model: Holds data specific ONLY to Specialists
model SpecialistProfile {
  id                 Int      @id @default(autoincrement())
  specialization     String
  certificationImage String
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  // One-to-One relationship with User:
  // Each SpecialistProfile belongs to exactly one User.
  // The @unique constraint on userId ensures a user can only have one SpecialistProfile.
  userId             Int      @unique
  user               User     @relation(fields: [userId], references: [id])
}

// FarmerProfile Model: Holds data specific ONLY to Farmers
model FarmerProfile {
  id        Int      @id @default(autoincrement())
  farmName  String?  // Optional: Farm name
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // One-to-One relationship with User:
  // Each FarmerProfile belongs to exactly one User.
  // The @unique constraint on userId ensures a user can only have one FarmerProfile.
  userId    Int      @unique
  user      User     @relation(fields: [userId], references: [id])
}