<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>KrishiCare Admin - Pending Specialists</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Bootstrap Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet">
    <link rel="stylesheet" href="css/style.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@100..900&display=swap" rel="stylesheet">
    <style>
      /* Basic CSS for the layout */
      body {
        font-family: 'Inter', sans-serif;
        background-color: #f8f9fa;
      }
      .sidebar {
        width: 250px;
        background-color: #ffffff;
        min-height: 100vh;
        border-right: 1px solid #dee2e6;
      }
      .main-content {
        background-color: #f8f9fa;
      }
      .text-primary-green {
        color: #28a745;
      }
      .nav-link.active {
        background-color: #e9ecef;
        color: #495057 !important;
        font-weight: 500;
        border-radius: 8px;
      }
      .nav-link {
        color: #6c757d;
        transition: color 0.2s, background-color 0.2s;
      }
      .nav-link:hover {
        color: #495057;
      }
      .table.recent-reports-table img {
        border: 1px solid #dee2e6;
      }
    </style>
</head>
<body>
    <div class="d-flex">
        <!-- Sidebar -->
        <div class="sidebar d-flex flex-column p-3">
            <h5 class="mb-4">
                <span class="text-primary-green fw-semibold">Krishi</span><span class="text-dark">Care</span>
            </h5>
            <ul class="nav flex-column gap-2">
                <li><a class="nav-link" href="/admin/dashboard"><i class="bi bi-grid me-2"></i>Dashboard</a></li>
                <li><a class="nav-link" href="/admin/farmers"><i class="bi bi-person me-2"></i>Farmers</a></li>
                <li><a class="nav-link" href="/admin/specialists"><i class="bi bi-file-person me-2"></i>Specialists</a></li>
                <li><a class="nav-link active" href="/admin/pending"><i class="bi bi-hourglass-split me-2"></i>Pending Specialists</a></li>
            </ul>
            <div class="mt-auto pt-3 border-top">
                <a href="/admin/logout" class="nav-link text-danger d-flex align-items-center">
                    <i class="bi bi-box-arrow-right me-2"></i> Logout
                </a>
            </div>
        </div>
        
        <!-- Main Content -->
        <div class="main-content flex-grow-1 p-4">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h4 class="fw-bold text-dark-blue m-0">Pending Specialists</h4>
                <a href="logout" class="btn btn-outline-secondary btn-sm">logout</a>
            </div>
            
            <h6 class="fw-semibold text-dark-blue mt-5">Pending Specialists List</h6>
            <div class="table-responsive mt-3">
                <% if (pendingSpecialists.length > 0) { %>
                    <table class="table recent-reports-table align-middle">
                        <thead>
                            <tr>
                                <th>Specialist</th>
                                <th>Phone</th>
                                <th>Specialization</th>
                                <th>Certificate</th>
                                <th>Submitted on</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            <!-- Loop through pending specialists data -->
                            <% pendingSpecialists.forEach(specialist => { %>
                                <tr>
                                    <td>
                                        <div class="d-flex align-items-center">
                                            <img src="<%= specialist.userId.profilePictureUrl || 'https://placehold.co/40x40/E5E7EB/1F2937?text=U' %>" class="rounded-circle me-2" width="40" height="40" alt="<%= specialist.userId.fullName %> Photo">
                                            <span><%= specialist.userId.fullName %></span>
                                        </div>
                                    </td>
                                    <td><%= specialist.userId.phoneNumber %></td>
                                    <td><%= specialist.specialization %></td>
                                    <td>
                                        <% if (specialist.certificationImage) { %>
                                            <a href="<%= specialist.certificationImage %>" target="_blank" class="btn btn-sm btn-outline-primary">View</a>
                                        <% } else { %>
                                            <span class="text-muted">N/A</span>
                                        <% } %>
                                    </td>
                                    <td><%= new Date(specialist.createdAt).toLocaleDateString() %></td>
                                    <td>
                                        <div class="d-flex gap-2">
                                            <!-- Form to handle the acceptance of a specialist -->
                                            <form action="/admin/verify-specialist/<%= specialist._id %>" method="POST">
                                                <button type="submit" class="btn btn-sm btn-success" style="background-color: #23cc34; color: white;">Accept</button>
                                            </form>
                                            <!-- Form to handle the rejection of a specialist -->
                                            
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            <% }); %>
                        </tbody>
                    </table>
                <% } else { %>
                    <p>No pending specialist applications found.</p>
                <% } %>
            </div>
        </div>
    </div>
</body>
</html>
