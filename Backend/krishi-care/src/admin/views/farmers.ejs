<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>KrishiCare Admin - Farmers</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    
    <!-- Bootstrap Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet">
    
    <link rel="stylesheet" href="css/style.css">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@100..900&display=swap" rel="stylesheet">

    <style>
        body {
            font-family: 'Inter', sans-serif;
            background-color: #f8f9fa;
        }
        
        .d-flex {
            display: flex;
        }

        .sidebar {
            width: 250px;
            min-height: 100vh;
            background-color: #fff;
            border-right: 1px solid #e0e0e0;
        }
        
        .sidebar .nav-link {
            color: #495057;
            padding: 12px 16px;
            transition: all 0.3s ease;
            border-radius: 8px;
        }
        
        .sidebar .nav-link:hover,
        .sidebar .nav-link.active {
            color: #28a745;
            background-color: #e9f6ec;
        }
        
        .text-primary-green {
            color: #28a745;
        }
        
        .main-content {
            flex-grow: 1;
            padding: 2rem;
        }
        
        .recent-reports-table img {
            object-fit: cover;
        }
        
        .recent-reports-table th {
            color: #6c757d;
            font-weight: 500;
        }
        
        .table > :not(caption) > * > * {
            padding: 1rem 1rem;
        }
    </style>
</head>
<body>
    <div class="d-flex">
        <!-- Sidebar -->
        <div class="sidebar d-flex flex-column p-3">
            <h5 class="mb-4">
                <span class="text-primary-green fw-semibold">Krishi</span><span class="text-dark">Care</span>
            </h5>
            <ul class="nav flex-column gap-2">
                <li><a class="nav-link" href="/admin/dashboard"><i class="bi bi-grid me-2"></i>Dashboard</a></li>
                <li><a class="nav-link active" href="/admin/farmers"><i class="bi bi-person me-2"></i>Farmers</a></li>
                <li><a class="nav-link" href="/admin/specialists"><i class="bi bi-file-person me-2"></i>Specialists</a></li>
                <li><a class="nav-link" href="/admin/pending"><i class="bi bi-hourglass-split me-2"></i>Pending Specialists</a></li>
            </ul>
            <div class="mt-auto pt-3 border-top">
                <a href="/admin/logout" class="nav-link text-danger d-flex align-items-center">
                    <i class="bi bi-box-arrow-right me-2"></i> Logout
                </a>
            </div>
        </div>
        
        <!-- Main Content -->
        <div class="main-content flex-grow-1 p-4">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h4 class="fw-bold text-dark-blue m-0">Farmers</h4>
                <a href="logout" class="btn btn-outline-secondary btn-sm">logout</a>
            </div>
            
            <!-- Farmers List Table -->
            <h6 class="fw-semibold text-dark-blue mt-5">Farmers List</h6>
            <div class="table-responsive mt-3">
                <table class="table recent-reports-table align-middle">
                    <thead>
                        <tr>
                            <th>Farmer</th>
                            <th>Phone</th>
                            <th>Farm Name</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (farmers && farmers.length > 0) { %>
                            <% farmers.forEach(farmer => { %>
                                <tr>
                                    <td>
  <div class="d-flex align-items-center">
    <img src="<%= (farmer.userId && farmer.userId.profilePictureUrl) 
                  ? farmer.userId.profilePictureUrl 
                  : 'https://placehold.co/40x40/E5E7EB/1F2937?text=U' %>" 
         class="rounded-circle me-2" width="40" height="40" 
         alt="<%= farmer.userId ? farmer.userId.fullName : 'Unknown' %> Photo">
    <span><%= farmer.userId ? farmer.userId.fullName : 'Unknown User' %></span>
  </div>
</td>                                    <td><%= farmer.userId ? farmer.userId.phoneNumber : 'Unkown number' %></td>
                                    <td><%= farmer.farmName %></td>
                                </tr>
                            <% }) %>
                        <% } else { %>
                            <tr>
                                <td colspan="3" class="text-center">
                                    <p class="text-muted"><%= errorMessage || 'No farmers found.' %></p>
                                </td>
                            </tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
