<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>KrishiCare Admin - Login</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  
  <!-- Bootstrap Icons -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet">
  
  <!-- Explicitly using the /admin prefix for static assets -->
  <link rel="stylesheet" href="/admin/css/style.css">

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@100..900&display=swap" rel="stylesheet">

</head>
<body>

  <div class="d-flex flex-column justify-content-center align-items-center vh-100 bg-light-purple">

    <!-- Logo and Title -->
    <div class="text-center mb-4">
      <!-- Correctly using the absolute path with the /admin prefix -->
      <img src="/admin/images/logo.png" alt="KrishiCare Logo" width="80" />
    </div>

    <!-- Registration Card -->
    <div class="card p-4 shadow register-card">
      <h5 class="text-center fw-bold mb-4 text-dark-blue">Login to your account</h5>
      <!-- The form now submits to the correct endpoint: /admin/login -->
      <form action="/admin/login" method="POST">
        <div class="mb-3">
          <label for="username" class="form-label">Username</label>
          <input type="text" id="username" name="username" class="form-control" placeholder="Enter Your Username" required>
        </div>

        <div class="mb-3">
          <label for="password" class="form-label">Password</label>
          <div class="input-group">
            <input type="password" id="password" name="password" class="form-control" placeholder="Enter Your Password" required>
            <span class="input-group-text"><i class="bi bi-eye"></i></span>
          </div>
        </div>

        <!-- The button type is now "submit" to trigger form submission -->
        <button type="submit" class="btn btn-primary-green w-100">Login</button>
        
      </form>
    </div>
  </div>
  
</body>
</html>
