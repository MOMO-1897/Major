<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>KrishiCare Admin - Dashboard</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet">
    <!-- Use a dynamic path that will be served by NestJS's static assets middleware -->
    <link rel="stylesheet" href="/admin/css/style.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@100..900&display=swap" rel="stylesheet">
</head>
<body>
    <div class="d-flex">
        <!-- Sidebar -->
        <div class="sidebar d-flex flex-column p-3">
            <h5 class="mb-4">
                <span class="text-primary-green fw-semibold">Krishi</span><span class="text-dark">Care</span>
            </h5>
            <ul class="nav flex-column gap-2">
                <li><a class="nav-link active" href="/admin/dashboard"><i class="bi bi-grid me-2"></i>Dashboard</a></li>
                <li><a class="nav-link" href="/admin/farmers"><i class="bi bi-person me-2"></i>Farmers</a></li>
                <li><a class="nav-link" href="/admin/specialists"><i class="bi bi-file-person me-2"></i>Specialists</a></li>
                <li><a class="nav-link" href="/admin/pending"><i class="bi bi-hourglass-split me-2"></i>Pending Specialists</a></li>
            </ul>
            <div class="mt-auto pt-3 border-top">
                <a href="/admin/logout" class="nav-link text-danger d-flex align-items-center">
                    <i class="bi bi-box-arrow-right me-2"></i> Logout
                </a>
            </div>
        </div>

        <!-- Main Content -->
        <div class="main-content flex-grow-1 p-4">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h4 class="fw-bold text-dark-blue m-0">Dashboard</h4>
                <a href="logout" class="btn btn-outline-secondary btn-sm">logout</a>
            </div>

            <h6 class="fw-semibold text-dark-blue">Insights</h6>
            <div class="row mt-3">
                <!-- Card 1 -->
                <div class="col-md-4">
                    <div class="insight-card">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <small class="fw-semibold text-muted">No. Of Farmers</small>
                                <h5 class="mt-1"><%= counts.farmers %></h5>
                            </div>
                            <i class="bi bi-emoji-smile fs-3"></i>
                        </div>
                        <a href="/admin/farmers" class="insight-link">View All</a>
                    </div>
                </div>

                <!-- Card 2 -->
                <div class="col-md-4">
                    <div class="insight-card">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <small class="fw-semibold text-muted">No. Of Specialists</small>
                                <h5 class="mt-1"><%= counts.specialists %></h5>
                            </div>
                            <i class="bi bi-person-badge fs-3"></i>
                        </div>
                        <a href="/admin/specialists" class="insight-link">View All</a>
                    </div>
                </div>

                <!-- Card 3 -->
                <div class="col-md-4">
                    <div class="insight-card">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <small class="fw-semibold text-muted">Pending Specialist Requests</small>
                                <h5 class="mt-1"><%= counts.pending %></h5>
                            </div>
                            <i class="bi bi-clock-history fs-3"></i>
                        </div>
                        <a href="/admin/pending" class="insight-link">View All</a>
                    </div>
                </div>
            </div>
            
            <!-- Recent Reports Section -->
            <h6 class="fw-semibold text-dark-blue mt-5">Recent Reports</h6>
            <div class="table-responsive mt-3">
                <table class="table recent-reports-table align-middle">
                    <thead>
                        <tr>
                            <th>Farmer</th>
                            <th>Title</th>
                            <th>Category</th>
                            <th>Description</th>
                            <th>Image</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        <!-- Loop through the 'reports' array passed from the controller -->
                        <% reports.forEach(report => { %>
                            <tr>
                                <td>
                                    <div class="d-flex align-items-center">
                                        <img src="<%= report.farmerPhoto %>" class="rounded-circle me-2" width="40" height="40" alt="Farmer Photo">
                                        <span><%= report.farmerName %></span>
                                    </div>
                                </td>
                                <td><%= report.title %></td>
                                <td><span class="badge <%= report.categoryBadge %>"><%= report.category %></span></td>
                                <td><%= report.description %></td>
                                <td>
                                    <!-- Use the 'imageLink' from the report object -->
                                    <a href="<%= report.imageLink %>" target="_blank" class="btn btn-sm btn-outline-primary">View</a>
                                </td>
                                <td>
                                    <!-- Form to handle the deletion of a report -->
                                    <form action="/admin/delete-report/<%= report._id %>" method="POST">
                                        <button type="submit" class="btn btn-sm btn-danger" style="background-color: #EF4444; color: white;">Delete</button>
                                    </form>
                                </td>
                            </tr>
                        <% }); %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</body>
</html>
